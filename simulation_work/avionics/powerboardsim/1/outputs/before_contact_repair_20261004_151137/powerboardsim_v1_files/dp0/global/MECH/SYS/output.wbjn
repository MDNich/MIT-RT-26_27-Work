    Company="ANSYS",
    ProviderName="Disk",
)

template2 = GetTemplate(TemplateName="Geometry")
system2 = template2.CreateSystem(Position="Below", RelativeTo=system1)
geometry2 = system2.GetContainer(ComponentName="Geometry")
geometryComponent2 = system2.GetComponent(Name="Geometry")

if (not os.path.isfile(stpFile)):
    MessageBox.Show("The STEP file specified in this Workbench script "+stpFile+"is invalid.  This is most likely because the file has been moved to a different location since the export.")
    dir = "."
    filters = "All files (*.*)|*.*"

    slash = -1
    try:
        slash = stpFile.rindex('\\')
    except Exception as ignore:
        pass

    if (slash < 0):
        try:
            slash = stpFile.rindex('/')
        except Exception as ignore:
            pass

    if (slash > 0):
        slash += 1
        stpFile = stpFile[slash:]

    res = FileDialog.ShowOpenDialog(Window.MainWindow,dir,filters,0,"Select Geometry STEP File",stpFile)
    if (res[0] == DialogResult.OK):
        stpFile = res[1]
    else:
        stpFile = ""

if (stpFile != "" and os.path.isfile(stpFile)):
    try:
        geometry2.SetFile(FilePath=stpFile)

        system3 = template3.CreateSystem(ComponentsToShare=[engineeringDataComponent1, geometryComponent2], Position="Right", RelativeTo=system1)
    except Exception as ex:
        MessageBox.Show("The STEP file could not be found to be loaded into the Geometry.  Please add it to the Geometry component before proceeding.")
        pass
else:
    MessageBox.Show("The STEP file could not be found to be loaded into the Geometry.  Please add it to the Geometry component before proceeding.")

if (not ansysVersion.startswith("19.1") and not ansysVersion.startswith("19.2")):
    pyFile = stpFile.replace(".stp", ".py")
    if (not os.path.isfile(pyFile)):
        MessageBox.Show("The Workbench material assignment script specified in this script "+pyFile+" is invalid.  This is most likely because the file has been moved to a different location since the export.")
        dir = "."
        filters = "All files (*.*)|*.*"

        slash = -1
        try:
            slash = pyFile.rindex('\\')
        except Exception as ignore:
            pass

        if (slash < 0):
            try:
                slash = pyFile.rindex('/')
            except Exception as ignore:
                pass

        if (slash > 0):
            slash += 1
            pyFile = pyFile[slash:]

        res = FileDialog.ShowOpenDialog(Window.MainWindow,dir,filters,0,"Select Workbench material assignment script",pyFile)
        if (res[0] == DialogResult.OK):
            pyFile = res[1]
        else:
            pyFile = ""
    if (pyFile != "" and os.path.isfile(pyFile)):
        try:
            feaModelComponent = system3.GetComponent(Name="Model")
            feaModelComponent.Refresh()
            model = system3.GetContainer(ComponentName="Model")
            model.Edit()
            model.SendCommand("execfile(\""+pyFile.replace("\\","\\\\")+"\")", Language="Python")
        except Exception as ex:
            MessageBox.Show("The Workbench material assignment script could not be found to be loaded into the Workbench.  Please assign materials before proceeding.")
            pass
    else:
