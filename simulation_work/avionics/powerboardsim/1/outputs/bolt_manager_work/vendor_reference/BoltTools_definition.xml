        <separator/>
        <entry name="Contact Results Wizard" icon="contact_tool_pressure">
          <callbacks>
            <onclick>ShowContactResultsWizard</onclick>
          </callbacks>
        </entry>
        <entry name="Contact Status Export Wizard" icon="contact_tool_pressure">
          <callbacks>
            <onclick>ShowContactStatusWizard</onclick>
          </callbacks>
        </entry>
      </entry>
      <entry name="Meshing" icon="mesh_obj">
        <entry name="Add Mesh Copy" icon="mesh_controls_mesh_copy_beta">
          <callbacks>
            <onclick>AddMeshCopy</onclick>
          </callbacks>
        </entry>
      </entry>
      <entry name="CoordinateSystems" icon="coordinatesystems">
        <entry name="Add CS for Each in Selection" icon="coordinatesystems">
          <callbacks>
            <onclick>AddCsForSel</onclick>
          </callbacks>
        </entry>
        <entry name="Flip Z Axis" icon="coordinatesystems">
          <callbacks>
            <onclick>FlipZAxis</onclick>
          </callbacks>
        </entry>
        <separator/>
        <entry name="Add Bolt CS" icon="coordinatesystems">
          <callbacks>
            <onclick>AddCsForBolt</onclick>
          </callbacks>
        </entry>
        <entry name="Get Bolt CS" icon="coordinatesystems">
          <callbacks>
            <onclick>GetBoltCs</onclick>
          </callbacks>
        </entry>
      </entry>
      <entry name="Preloads" icon="environment_structural_bolt_pretension">
        <entry name="Assign Preload CS" icon="coordinatesystems">
          <callbacks>
            <onclick>AssignPreloadCs</onclick>
          </callbacks>
        </entry>
        <entry name="Move Preload CS" icon="coordinatesystems">
          <callbacks>
            <onclick>MovePreloadsCs</onclick>
          </callbacks>
        </entry>
        <separator/>
        <entry name="Get Preload From CS" icon="environment_structural_bolt_pretension">
          <callbacks>
            <onclick>GetPreloadsFromCs</onclick>
          </callbacks>
        </entry>
        <entry name="Get CS From Preload" icon="coordinatesystems">
          <callbacks>
            <onclick>GetCsFromPreloads</onclick>
          </callbacks>
        </entry>
        <entry name="Get Preloads From Selection" icon="environment_structural_bolt_pretension">
          <callbacks>
            <onclick>GetPreloadsFromSelection</onclick>
          </callbacks>
        </entry>
        <entry name="Set Selection From Preloads" icon="body_select">
          <callbacks>
            <onclick>SetGraphicSelectionFromPreloads</onclick>
          </callbacks>
        </entry>
        <entry name="Get Preloads From Probes" icon="solution_probe">
          <callbacks>
            <onclick>GetPreloadsFromProbes</onclick>
          </callbacks>
        </entry>
        <separator/>
        <entry name="Rename Preloads Based On Def" icon="environment_structural_bolt_pretension">
          <callbacks>
            <onclick>RenamePreloadsBasedOnDef</onclick>
          </callbacks>
        </entry>
        <separator/>
        <entry name="Export Preload Values" icon="environment_structural_bolt_pretension">
          <callbacks>
            <onclick>ExportPreloadValues</onclick>
          </callbacks>
        </entry>
        <entry name="Import Preload Values" icon="environment_structural_bolt_pretension">
          <callbacks>
            <onclick>ImportPreloadValues</onclick>
          </callbacks>
        </entry>
      </entry>
      <entry name="Beams" icon="connections_beam">
        <entry name="Show Summary Table" icon="layout_tabular_data">
          <callbacks>
            <onclick>ShowObjSummaryTable</onclick>
          </callbacks>
        </entry>
        <entry name="Create Beams From Solids" icon="body_select">
          <callbacks>
            <onclick>CreateBeamsFromSolids</onclick>
          </callbacks>
        </entry>
      </entry>
      <entry name="PostProcessing" icon="solution_probe">
        <entry name="Show Summary Table" icon="layout_tabular_data">
          <callbacks>
            <onclick>ShowObjSummaryTable</onclick>
          </callbacks>
        </entry>
        <entry name="Reaction Probes Wizard" icon="solution_probe">
          <callbacks>
            <onclick>ShowReactionResultsPanel</onclick>
          </callbacks>
        </entry>
        <entry name="Connections Post Wizard" icon="bolt_tool_adjustment">
          <callbacks>
            <onclick>ShowPostWizard</onclick>
          </callbacks>
        </entry>
      </entry>
      <entry name="Tree Helper" icon="tree">
        <entry name="Object Connections Tree" icon="tree">
          <callbacks>
            <onclick>ShowObjConnectionTree</onclick>
          </callbacks>
        </entry>
        <entry name="Show Tree Helper" icon="tree">
          <callbacks>
            <onclick>ShowTreeHelper</onclick>
          </callbacks>
        </entry>
        <entry name="Tree Group Helper" icon="folder">
          <callbacks>
            <onclick>ShowTreeGroupSelector</onclick>
          </callbacks>
        </entry>
        <entry name="Object External Data Viewer" icon="layout_tabular_data">
          <callbacks>
            <onclick>ShowObjectExtDataViewer</onclick>
          </callbacks>
        </entry>|
        <entry name="Object Selector" icon="tree">
          <callbacks>
            <onclick>ShowObjectSelector</onclick>
          </callbacks>
        </entry>|
      </entry>
      <entry name="Wizards" icon="wizard">
        <entry name="Setup Wizard" icon="wizard">
          <callbacks>
            <onclick>ShowSetupWizard</onclick>
          </callbacks>
        </entry>
        <separator/>
        <!--  				<entry name="Solid Body Hole Detection Wizard" icon="feature_detection"><callbacks><onclick>ShowSolidBodyHoleDetectionWizard</onclick></callbacks></entry>-->
        <entry name="Surface Body Hole Detection Wizard" icon="feature_detection">
          <callbacks>
            <onclick>ShowHoleDetectionWizard</onclick>
          </callbacks>
        </entry>
        <separator/>
        <entry name="Cone of Compression Imprint" icon="Contacts">
          <callbacks>
            <onclick>ShowConeOfCompressionWizard</onclick>
          </callbacks>
        </entry>
        <separator/>
        <entry name="Reaction Probes Wizard" icon="solution_probe">
          <callbacks>
            <onclick>ShowReactionResultsPanel</onclick>
          </callbacks>
        </entry>
        <entry name="Connections Post Wizard" icon="bolt_tool_adjustment">
          <callbacks>
            <onclick>ShowPostWizard</onclick>
          </callbacks>
        </entry>
        <separator/>
        <entry name="Contact Results Wizard" icon="contact_tool_pressure">
          <callbacks>
            <onclick>ShowContactResultsWizard</onclick>
          </callbacks>
        </entry>
      </entry>
      <entry name="Instances" icon="extendto_instances">
        <entry name="Instance Manager" icon="extendto_instances" userobject='GroupManager'></entry>
        <entry name="Rename All Groups From Standard Part" icon="extendto_instances">
          <callbacks>
            <onclick>RenameAllGroupsFromStandardPart</onclick>
          </callbacks>
        </entry>
        <separator/>
        <entry name="Parts Library" icon="part">
          <callbacks>
            <onclick>ShowPartsLibrary</onclick>
          </callbacks>
        </entry>
        <separator/>
        <entry name="Run Standard Part Scripts for Selected" icon="part">
          <callbacks>
            <onclick>RunStandardPartScript</onclick>
          </callbacks>
