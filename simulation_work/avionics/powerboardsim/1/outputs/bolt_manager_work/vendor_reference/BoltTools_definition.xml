      <!-- <entry name="ApdlBolt" icon="bolt_tool_adjustment" userobject='ApdlBoltManager'></entry> -->
      <entry name="Help" icon="help_1">
        <callbacks>
          <onclick>ShowHelpDoc</onclick>
        </callbacks>
      </entry>
    </toolbar>
  </interface>
  <simdata context="Mechanical">
    <object name="GroupManager" class='GroupManager' affectsSolution="false" version="1" caption="Instance Manager" icon="icon_extendto_instances_16x16" isload="false" color="#0000FF">
      <target type="datamodel"/>
      <callbacks>
        <CanAdd>CanAdd_GroupManager</CanAdd>
        <CanDuplicate>CanDuplicate_GroupManager</CanDuplicate>
        <action name="CreateGroup" caption="Create Group" icon="icon_mesh_edit_node_merge_group_16x16">CreateGroup</action>
        <action name="CreateGroupsFromModel" caption="Create Groups From Geometry" icon="icon_mesh_edit_node_merge_group_16x16">CreateGroupsFromModel</action>
      </callbacks>
      <property name="OnSelection"  caption= "On Selection" control="select" default="Select Bodies">
        <attributes options="Hide Others,Hide Others And Fit,Select Bodies,Highlight Bodies" />
      </property>
      <propertygroup name='AutoCreation' caption = "Auto Creation" visible = 'true'>
        <property name="Tolerance"  caption= "Tolerance" control="float" default="0.001"></property>
        <property name="MinNumber"  caption= "Min. Number" control="integer" default="2"></property>
      </propertygroup>
    </object>

    <object name="Group" class='Group' version="1" affectsSolution="false" caption="Group" icon="icon_mesh_edit_node_merge_group_16x16" isload="false" color="#0000FF">
      <target type="userobject" name = "GroupManager"/>
      <callbacks>
        <CanDuplicate>CanDuplicate_Group</CanDuplicate>
        <action name="RenameFromStandardPart" caption="Rename From Standard Part" icon="icon_mesh_edit_node_merge_group_16x16">RenameFromStandardPart</action>
        <action name="RenameTreeBodiesFromGroup" caption="Rename Bodies From Group" icon="icon_mesh_edit_node_merge_group_16x16">RenameTreeBodiesFromGroup</action>
      </callbacks>
      <property name="Geometry"  caption= "Geometry" control="scoping">
        <attributes selection_filter="body" />
        <callbacks>
          <OnValidate>Group_Geometry_OnValidate</OnValidate>
        </callbacks>
      </property>
      <property name="OnSelection"  caption= "On Selection" control="select" default="Default">
        <attributes options="Default, Hide Others,Hide Others And Fit,Select Bodies,Highlight Bodies" />
      </property>
      <property name="IsStandardPart"  caption= "Is Standard Part" control="select" default="No">
        <attributes options="Yes,No" />
        <callbacks>
          <OnValidate>OnValidate_Group_IsStandardPart</OnValidate>
        </callbacks>
      </property>
      <propertygroup name='StandardPartData' caption = "Standard Part Data" visible = 'false'>
        <property name="Name"  caption= "Name" control="select" default="None">
          <attributes options="None" />
          <callbacks>
            <OnActivate>OnActivate_Group_StandardPart</OnActivate>
            <OnValidate>OnValidate_Group_StandardPart</OnValidate>
          </callbacks>
        </property>
        <property name="Description"  caption= "Description" control="text" default = "NA" readonly='true'></property>
        <property name="PyFileName"  caption= "Py File" control="select" default = "NA">
          <attributes options="NA" />
        </property>
        <property name="UserArg1"  caption= "User Arg 1" control="Text" default = "None"></property>
        <property name="UserArg2"  caption= "User Arg 2" control="Text" default = "None"></property>
        <property name="UserArg3"  caption= "User Arg 3" control="Text" default = "None"></property>
      </propertygroup>
    </object>

    <object name="ApdlBoltManager" class='ApdlBoltManager' affectsSolution="false" version="1" caption="APDL Bolt Manager" icon="icon_bolt_tool_adjustment_16x16" isload="false" color="#0000FF">
      <target type="datamodel"/>
      <callbacks>
        <CanAdd>CanAdd_ApdlBoltManager</CanAdd>
        <CanDuplicate>CanDuplicate_ApdlBoltManager</CanDuplicate>
        <action name="CreateApdlBolt" caption="Create ApdlBolt" icon="bolt_tool_adjustment">CreateApdlBolt</action>
      </callbacks>
    </object>

    <object name="ApdlBolt" class = "ApdlBolt" version="1" caption="Bolt" icon="icon_bolt_tool_adjustment_16x16" isload="false" color="#0000FF">
      <target type="userobject" name = "ApdlBoltManager"/>
      <callbacks>
        <!-- Callbacks for APDL commands at various points in the input file. -->
        <GetCommands location='pre'>ApdlBolt_GetCommands_Pre</GetCommands>
        <GetCommands location='solve'>ApdlBolt_GetCommands_Solve</GetCommands>
        <GetCommands location='post'>ApdlBolt_GetCommands_Post</GetCommands>
        <action name="ActivateCS" caption="Activate CS" icon="icon_coordinatesystems_16x16">ActivateObjCs</action>
      </callbacks>

      <propertygroup name='Parts' caption = "Parts">
        <property name='BoltName' caption = "Bolt Name" control='select'>
          <attributes options="" />
          <callbacks>
            <OnActivate>ApdlBoltNameActivate</OnActivate>
            <OnValidate>ApdlBoltValidate</OnValidate>
          </callbacks>
        </property>
        <property name='BoltWasherName' caption = "Bolt Washer Name" control='select' default='None'>
          <attributes options="None" />
          <callbacks>
            <OnActivate>ApdlBoltNameActivate</OnActivate>
            <OnValidate>ApdlBoltValidate</OnValidate>
          </callbacks>
        </property>
        <property name='NutName' caption = "Nut Name" control='select' default='None'>
          <attributes options="None" />
          <callbacks>
            <OnActivate>ApdlBoltNameActivate</OnActivate>
            <OnValidate>ApdlBoltValidate</OnValidate>
          </callbacks>
        </property>
        <property name='NutLoc' caption = "Nut Location" control='float' unit='Length' isparameter="true" default="0 [mm]">
          <callbacks>
            <OnValidate>ApdlBoltValidate</OnValidate>
          </callbacks>
        </property>
        <property name='NutWasherName' caption = "Nut Washer Name" control='select' default='None'>
          <attributes options="None" />
          <callbacks>
            <OnActivate>ApdlBoltNameActivate</OnActivate>
            <OnValidate>ApdlBoltValidate</OnValidate>
          </callbacks>
        </property>
      </propertygroup>

      <propertygroup name='CS' caption = "Coordinate Systems Selection">
        <property name="SelectCs"  caption= "Select Coordinate System Now" control="select" default="No">
          <attributes options="No,Yes" />
          <callbacks>
            <OnValidate>SelectCoordinateSystems</OnValidate>
          </callbacks>
        </property>
        <property name="CsIds" caption = "Coordinate Systems" control="Text" readonly="true" default="None" />
      </propertygroup>
      <propertygroup name='Cmds' caption = "User APDL">
        <property name="UserApdlCommands" caption="User APDL" Default='Click to Edit' control="applycancel" >
          <callbacks>
            <onapply>ApplyUserApdlCommands</onapply>
          </callbacks>
        </property>
      </propertygroup>
      <propertygroup name='Display'>
        <property name="Visible" control="select" default="Yes" needupdate='false'>
          <attributes options="No,Yes" />
        </property>
        <property name="DepthTest"  caption= "Depth Test" control="select" default="Yes" needupdate='false'>
          <attributes options="No,Yes" />
          <callbacks>
            <OnValidate>ApdlBolt_Display_Validate</OnValidate>
          </callbacks>
        </property>
        <property name="Transparency" control="float" default="0" needupdate='false'>
          <callbacks>
            <OnValidate>ApdlBolt_Display_Validate</OnValidate>
          </callbacks>
        </property>
      </propertygroup>
    </object>
  </simdata>
</extension>


