        <separator/>
        <entry name="Activate Contacts from Selection" icon="connections_contact">
          <callbacks>
            <onclick>ActivateContactsForSelection</onclick>
          </callbacks>
        </entry>
        <separator/>
        <entry name="Remove Selection from All Contacts" icon="connections_contact">
          <callbacks>
            <onclick>RemoveEntityFromAllContacts</onclick>
