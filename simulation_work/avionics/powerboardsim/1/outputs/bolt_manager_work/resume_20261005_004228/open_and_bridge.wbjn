import System,traceback
OUT='Z:\\Developer\\MIT_Rkt_Team\\2026-7\\MIT-RT-26_27-Work\\simulation_work\\avionics\\powerboardsim\\1\\outputs\\bolt_manager_work\\resume_20261005_004228'
try:
    Open(FilePath='Z:\\Developer\\MIT_Rkt_Team\\2026-7\\MIT-RT-26_27-Work\\simulation_work\\avionics\\powerboardsim\\1\\powerboardsim_v1.wbpj')
    systems=GetAllSystems()
    System.IO.File.WriteAllText(OUT+r'\systems.txt',u'\n'.join([unicode(s.Name)+u' | '+unicode(s.DisplayText) for s in systems]))
    sys=GetSystem(Name='SYS')
    mech=sys.GetContainer(ComponentName='Model')
    mech.Edit(Interactive=True)
    mech.SendCommand(Language='Python',Command="execfile("+repr(OUT+r'\bridge.py')+")")
    System.IO.File.WriteAllText(OUT+r'\journal_done.txt','Ready')
except:
    System.IO.File.WriteAllText(OUT+r'\journal_error.txt',traceback.format_exc())
