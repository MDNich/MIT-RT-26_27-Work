/BATCH
RESUME,model,db
/POST1
FILE,tear,rst
SET,LIST
SET,LAST
*GET,NSET,ACTIVE,0,SET,NSET
/NOPR
*CFOPEN,accepted_history,csv
*VWRITE
('set,time,ux_mm,fx_N,uy_mm,sx_MPa,eppl,damage')
*DO,II,1,NSET
SET,,,,,,,II
*GET,SB,ACTIVE,0,SET,SBST
*IF,SB,EQ,999999,THEN
*CYCLE
*ENDIF
*GET,TT,ACTIVE,0,SET,TIME
*GET,UX1,NODE,2,U,X
*GET,UY1,NODE,3,U,Y
*GET,F1,NODE,2,RF,FX
*GET,F2,NODE,3,RF,FX
FX1=F1+F2
SHELL,TOP
ETABLE,SXX,S,X
ETABLE,EPL,NL,EPEQ
ETABLE,DMG,GDMG
*GET,SX1,ELEM,1,ETAB,SXX
*GET,EP1,ELEM,1,ETAB,EPL
*GET,DD1,ELEM,1,ETAB,DMG
*VWRITE,II,TT,UX1,FX1,UY1,SX1,EP1,DD1
(F8.0,7(',',E19.11))
*ENDDO
*CFCLOS
/EXIT,NOSAVE
