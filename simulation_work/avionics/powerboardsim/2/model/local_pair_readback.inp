! Read each converged active-cell and neighbouring-hardware contact pair.
ALLSEL,ALL
SET,LAST
*GET,NSAV,ACTIVE,0,SET,NSET
*CFOPEN,case_pairs,csv
*VWRITE
('set,time,pair,elements,closed,p_MPa,pen_mm,fx_N,fy_N,fz_N')
*DO,IK,1,NSAV
  ALLSEL,ALL
  SET,,,,,,,IK
  *GET,IKSUB,ACTIVE,0,SET,SBST
  *IF,IKSUB,EQ,999999,THEN
    *CYCLE
  *ENDIF
  *GET,IKTIME,ACTIVE,0,SET,TIME
  *DO,IP,861,862
    ESEL,S,TYPE,,862
    ESEL,R,REAL,,IP
    *GET,NT,ELEM,0,COUNT
    ETABLE,ERAS
    ETABLE,GSTATE,NMISC,41
    ETABLE,GPR,SMISC,13
    ETABLE,GFX,NMISC,43
    ETABLE,GFY,NMISC,44
    ETABLE,GFZ,NMISC,45
    ESORT,ETAB,GPR,0,0
    *GET,GPMAX,SORT,0,MAX
    GDMAX=0
    *DO,ISQ,9,12
      ETABLE,GDEP,NMISC,ISQ
      ESORT,ETAB,GDEP,0,0
      *GET,GDVAL,SORT,0,MAX
      GDMAX=MAX(GDMAX,GDVAL)
    *ENDDO
    SSUM
    *GET,SFX,SSUM,0,ITEM,GFX
    *GET,SFY,SSUM,0,ITEM,GFY
    *GET,SFZ,SSUM,0,ITEM,GFZ
    ESEL,R,ETAB,GSTATE,2,3
    *GET,NCLOSE,ELEM,0,COUNT
    *VWRITE,IK,IKTIME,IP,NT,NCLOSE,GPMAX,GDMAX,SFX,SFY,SFZ
(F6.0,',',E16.9,3(',',F8.0),5(',',E14.7))
  *ENDDO
*ENDDO
*CFCLOS
ALLSEL,ALL
