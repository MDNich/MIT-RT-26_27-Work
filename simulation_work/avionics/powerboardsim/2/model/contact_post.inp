  cnt%jj%=ntemp
 *enddo
 *vwrite,ii,tcur,countc,cnt0,cnt1,cnt2,cnt3,pmax,gmax
 (F6.0,',',E16.8,5(',',F10.0),2(',',E16.8))
*enddo
