/batch
resume,file,rdb
/post1
file,file,rst
set,last
*get,nset,active,0,set,nset
*cfopen,case_contact,csv
*vwrite
('set,time_s,n_contact,far,near,sliding,sticking,p_max_Pa,pen_max_m')
*do,ii,1,nset
 allsel,all
