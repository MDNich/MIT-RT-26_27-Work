 *get,tcur,active,0,set,time
 esel,s,type,,853
 *get,countc,elem,0,count
 etable,eras
 etable,cs,nmisc,41
 etable,cpres,smisc,13
 etable,cpen,cont,pene,max
 esort,etab,cpres,0,0
 *get,pmax,sort,0,max
 esort,etab,cpen,0,0
 *get,gmax,sort,0,max
 *do,jj,0,3
  esel,s,type,,853
  esel,r,etab,cs,jj,jj
