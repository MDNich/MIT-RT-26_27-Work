! Conserve enthalpy in each nodal annular control volume, independently on each transverse ray.
XXOLD(1)=0.5*RPOS**2
XXNEW(1)=0.5*RNEW**2
XXOLD(RN+2)=0.5*REND**2
XXNEW(RN+2)=0.5*REND**2
*DO,IR,1,RN
DR=(REND-RPOS)/RN
RA=RPOS+(IR-1)*DR
XXOLD(IR+1)=0.5*RA**2+DR*(3*RA+DR)/6
DR=(REND-RNEW)/RN
RA=RNEW+(IR-1)*DR
XXNEW(IR+1)=0.5*RA**2+DR*(3*RA+DR)/6
*ENDDO
*DO,IB,1,RN+1
*DO,JR,1,NRING
II=(IB-1)*NRING+JR
HPREF(II+NRING)=HPREF(II)+(XXOLD(IB+1)-XXOLD(IB))*HV(II)
*ENDDO
*ENDDO
JSCAN=1
*DO,IR,1,RN+2
*DO,IB,JSCAN,RN+1
JSCAN=IB
SCANDEL=(XXNEW(IR)-XXOLD(IB+1))/((REND-RPOS)*REND)
*IF,SCANDEL,LE,0,THEN
*EXIT
*ENDIF
*ENDDO
*DO,JR,1,NRING
II=(JSCAN-1)*NRING+JR
JJ=(IR-1)*NRING+JR
HNEW(JJ)=HPREF(II)+(XXNEW(IR)-XXOLD(JSCAN))*HV(II)
*ENDDO
*ENDDO
*DO,IR,1,RN+1
*DO,JR,1,NRING
JJ=(IR-1)*NRING+JR
HMEAN=(HNEW(JJ+NRING)-HNEW(JJ))/(XXNEW(IR+1)-XXNEW(IR))
TN(JJ)=TTAB(HMEAN)
*ENDDO
*ENDDO
RPOS=RNEW
ELTIME=TEND
*ENDDO
*IF,RNEW,GE,REND,THEN
/COM,IRIS_CF_TAIL_EXHAUSTED
*ENDIF
/EXIT,NOSAVE
