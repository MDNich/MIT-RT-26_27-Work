*DO,ISTEP,1,923
TSFACE=0
*DO,JR,1,NRING
TSFACE=TSFACE+TN(JR)/NRING
*ENDDO
JK=JFAC*EXP(-EOVER*(1/(TSFACE+273.15)-1/TREFK))
JACT=1/(1/JK+1/JCAP)
BB=JACT*GCP/HBASE
HACT=HBASE*BB/(EXP(BB)-1)
TLOAD=TG-JACT*HCOST/HACT
VFACE=JACT/(600.0*FCOS)
DTNOW=DTLIM
RNEW=RPOS+VFACE*DTNOW
*IF,RNEW,GE,REND,THEN
DTNOW=(REND-RPOS)/VFACE
RNEW=REND
*ENDIF
TEND=ELTIME+DTNOW
TSOURCE=TEND
