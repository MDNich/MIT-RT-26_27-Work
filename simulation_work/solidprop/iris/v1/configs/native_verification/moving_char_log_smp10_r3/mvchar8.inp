*IF,RNEW,GE,REND,THEN
*EXIT
*ENDIF
! Transfer the nonuniform temperature at its actual material radius.
! Piecewise logarithmic interpolation exactly transfers a log steady field.
*DO,IR,0,RN
RLOC=RNEW+(REND-RNEW)*IR/RN
POSIDX=(RLOC-RPOS)*RN/(REND-RPOS)
JLOW=NINT(POSIDX-MOD(POSIDX,1))
*IF,JLOW,GE,RN,THEN
JLOW=RN-1
*ENDIF
RA=RPOS+(REND-RPOS)*JLOW/RN
RB=RPOS+(REND-RPOS)*(JLOW+1)/RN
WT=LOG(RLOC/RA)/LOG(RB/RA)
*DO,JR,1,RINGN
ILOW=JLOW*RINGN+JR
TN(IR*RINGN+JR)=(1-WT)*TOLD(ILOW)+WT*TOLD(ILOW+RINGN)
*ENDDO
*ENDDO
RPOS=RNEW
*ENDDO
*IF,RNEW,GE,REND,THEN
/COM,IRIS_MOVING_CHAR_FINISHED
*ENDIF
/EXIT,NOSAVE
