RPOS=RSTART
ELTIME=0
*DO,IR,0,RN
RLOC=RSTART+(REND-RSTART)*IR/RN
*DO,JR,1,RINGN
TN(IR*RINGN+JR)=TSTART+TGRAD*LOG(RLOC/RSTART)
*ENDDO
*ENDDO
*DO,ISTEP,1,88
! Manufactured bulk temperature depends on position. Char rate and film
! for the actual FE step use the mapped face temperature from that step start.
TEX=TSTART+TGRAD*LOG(RPOS/RSTART)
JK=JFAC*EXP(-EOVER*(1/(TEX+273.15)-1/TREFK))
JE=1/(1/JK+1/JCAP)
BB=JE*GASCP/HBASE
HE=HBASE*BB/(EXP(BB)-1)
TG=TEX+(JE*HCOST-KCHAR*TGRAD/(FCOS*RPOS))/HE
TSFACE=0
*DO,JR,1,RINGN
TSFACE=TSFACE+TN(JR)/RINGN
*ENDDO
JK=JFAC*EXP(-EOVER*(1/(TSFACE+273.15)-1/TREFK))
JACT=1/(1/JK+1/JCAP)
BB=JACT*GASCP/HBASE
HACT=HBASE*BB/(EXP(BB)-1)
! Affine tangent to net inward flux at the mapped, solved surface temperature.
DJDT=JACT*(1-JACT/JCAP)*EOVER/(TSFACE+273.15)**2
DHDT=HACT*(1/BB-EXP(BB)/(EXP(BB)-1))*GASCP/HBASE*DJDT
HTAN=HACT+HCOST*DJDT-DHDT*(TG-TSFACE)
TLOAD=TSFACE+(HACT*(TG-TSFACE)-JACT*HCOST)/HTAN
VFACE=JACT/(RHOCHAR*FCOS)
DTNOW=DTLIM
RNEW=RPOS+VFACE*DTNOW
*IF,RNEW,GE,REND,THEN
DTNOW=(REND-RPOS)/VFACE
RNEW=REND
*ENDIF
/PREP7
*IF,ISTEP,GT,1,THEN
EDELE,ALL
*ENDIF
! Modify all unloaded nodes before rebuilding and shape-checking any brick.
*DO,IR,0,RN
RLOC=RPOS+(REND-RPOS)*IR/RN
*DO,JR,1,RINGN
INODE=IR*RINGN+JR
NMODIF,INODE,RLOC*DXR(JR),YN(JR),RLOC*DZR(JR)
*ENDDO
*ENDDO
