! Read-only validation of the native geometry database; no SOLVE.
/BATCH
RESUME,newmotor_phenolic_v0,db
/PREP7
ALLSEL,ALL
*GET,V0_NV,VOLU,0,COUNT
*GET,V0_NA,AREA,0,COUNT
*GET,V0_NL,LINE,0,COUNT
*GET,V0_NK,KP,0,COUNT
*VWRITE,V0_NV,V0_NA,V0_NL,V0_NK
('V0_GEOMETRY_COUNTS VOLUMES=',F6.0,' AREAS=',F6.0,' LINES=',F6.0,' KEYPOINTS=',F6.0)
/COM,V0_GEOMETRY_VALIDATED_NO_SOLVE
FINISH
/EXIT,NOSAVE

