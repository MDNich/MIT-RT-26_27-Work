\contentsline {figure}{\numberline {1}{\ignorespaces Corrected nominal radial layup. Layer widths are schematic; the stated dimensions are radial thicknesses.}}{2}{figure.0.1}%
\contentsline {figure}{\numberline {2}{\ignorespaces Local coupling in Simulation 1. Conversion modifies both the heat source and the properties at the following substep.}}{11}{figure.0.2}%
\contentsline {figure}{\numberline {3}{\ignorespaces Maximum \code {SVAR1} in one-percent radial bands of \code {phe0} at the last converged state. Hatched bands contain no result node and are filled by linear interpolation.}}{12}{figure.0.3}%
\contentsline {figure}{\numberline {4}{\ignorespaces Evolution of the maximum radial \code {SVAR1} in \code {phe0} for the saved states closest to 1 through \SI {6}{s}. The six plots are stacked vertically and use identical axes. The dotted lines and points mark the depths of the 0.80, 0.90, and 0.95 isoconversion levels when they are reached.}}{13}{figure.0.4}%
\contentsline {figure}{\numberline {5}{\ignorespaces Evolution of the maximum radial \code {SVAR2} in \code {phe0}, for the saved states nearest 1 to \SI {6}{s}. Every panel uses the same vertical scale; hatched bands contain no result node and are linearly interpolated.}}{15}{figure.0.5}%
\contentsline {figure}{\numberline {6}{\ignorespaces Axial dependence of \code {SVAR1} on the hot inner surface of \code {phe0}, measured from the lower plane of the meshed slice. All six panels use the same \(0\leq \alpha \leq 1\) scale.}}{17}{figure.0.6}%
\contentsline {figure}{\numberline {7}{\ignorespaces Axial dependence of \code {SVAR2} on the hot inner surface of \code {phe0}. The vertical scale is independent in every panel so that the small late rates remain visible; absolute values, not relative bar heights between panels, must be compared.}}{18}{figure.0.7}%
\contentsline {figure}{\numberline {8}{\ignorespaces Proposed physical sequence for Simulation 2 in Mechanical. Element deactivation is driven by recession, not directly by SVAR1.}}{22}{figure.0.8}%
\contentsline {figure}{\numberline {9}{\ignorespaces Accumulated virtual recession versus physical time. The curve is updated from fully synchronized states.}}{26}{figure.0.9}%
\contentsline {figure}{\numberline {10}{\ignorespaces Mean recession rate over the 135,900 inner-surface nodes. Error bars represent spatial \(\pm 1\sigma \).}}{26}{figure.0.10}%
\contentsline {figure}{\numberline {11}{\ignorespaces Virtual recession versus mean conversion. The curve shows that recession continues after \(\bar \alpha \) has nearly saturated.}}{27}{figure.0.11}%
\contentsline {figure}{\numberline {12}{\ignorespaces Recession rate versus mean conversion, with spatial \(\pm 1\sigma \).}}{27}{figure.0.12}%
\contentsline {figure}{\numberline {13}{\ignorespaces Radial maximum-SVAR1 profile at the latest common extracted state, including conversion contours and the virtual-recession line. Hatched bands contain no result node.}}{28}{figure.0.13}%
\contentsline {figure}{\numberline {14}{\ignorespaces Evolution of the radial maximum of SVAR1 in Simulation 2. The dashed green line in each panel marks the cumulative virtual-recession position.}}{29}{figure.0.14}%
\contentsline {figure}{\numberline {15}{\ignorespaces Evolution of the radial maximum of SVAR2. Migration of the maximum pyrolysis rate and progression of the virtual-recession line are shown on the same radial coordinate.}}{30}{figure.0.15}%
\contentsline {figure}{\numberline {16}{\ignorespaces Axial dependence of SVAR1 on the hot inner surface in Simulation 2. No recession line is drawn on the axial axis because recession is defined along the radial coordinate.}}{31}{figure.0.16}%
\contentsline {figure}{\numberline {17}{\ignorespaces Axial dependence of SVAR2 on the hot inner surface in Simulation 2. An independent vertical scale in each panel reveals the small values after surface saturation.}}{32}{figure.0.17}%
\contentsline {figure}{\numberline {18}{\ignorespaces Signed radial separation between the virtual-recession line and the 99\%, 95\%, and 90\% pyrolysis-conversion contours. The separation is defined as \(\Delta d_\alpha =d_\alpha -s\): a positive value places the contour deeper into the wall than recession. The vertical dotted line marks the first state at which virtual recession reaches \SI {1}{\micro m}.}}{34}{figure.0.18}%
