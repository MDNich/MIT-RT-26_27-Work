\babel@toc {french}{}\relax 
\contentsline {figure}{\numberline {1}{\ignorespaces Empilement radial nominal corrigé. La largeur des couches est schématique; les cotes indiquées sont les épaisseurs radiales.}}{2}{figure.0.1}%
\contentsline {figure}{\numberline {2}{\ignorespaces Couplage local de la simulation 1. La conversion modifie à la fois la source thermique et les propriétés au sous-pas suivant.}}{11}{figure.0.2}%
\contentsline {figure}{\numberline {3}{\ignorespaces Maximum de \code {SVAR1} dans des rubans radiaux de 1\,\% de \code {phe0}, au dernier état convergé. Les rubans hachurés ne contiennent aucun nœud de résultat et sont interpolés linéairement.}}{12}{figure.0.3}%
\contentsline {figure}{\numberline {4}{\ignorespaces Évolution du maximum radial de \code {SVAR1} dans \code {phe0}, pour les états sauvegardés les plus proches de 1 à \SI {6}{s}. Les six graphes sont empilés verticalement et utilisent les mêmes axes. Les traits pointillés et les points repèrent les profondeurs des isoconversions 0,80, 0,90 et 0,95 lorsqu'elles sont atteintes.}}{13}{figure.0.4}%
\contentsline {figure}{\numberline {5}{\ignorespaces Évolution du maximum radial de \code {SVAR2} dans \code {phe0}, pour les états sauvegardés les plus proches de 1 à \SI {6}{s}. Chaque panneau utilise la même échelle verticale; les rubans hachurés ne contiennent aucun nœud de résultat et sont interpolés linéairement.}}{15}{figure.0.5}%
\contentsline {figure}{\numberline {6}{\ignorespaces Dépendance axiale de \code {SVAR1} sur la face intérieure chaude de \code {phe0}, depuis le plan inférieur du tronçon maillé. Les six panneaux emploient la même échelle \(0\leq \alpha \leq 1\).}}{17}{figure.0.6}%
\contentsline {figure}{\numberline {7}{\ignorespaces Dépendance axiale de \code {SVAR2} sur la face intérieure chaude de \code {phe0}. L'échelle verticale est indépendante dans chaque panneau afin de rendre visibles les faibles taux tardifs; les valeurs absolues, et non les hauteurs relatives des barres entre panneaux, doivent être comparées.}}{18}{figure.0.7}%
\contentsline {figure}{\numberline {8}{\ignorespaces Chaîne physique proposée pour la simulation 2 dans Mechanical. La suppression est pilotée par la récession, non directement par SVAR1.}}{22}{figure.0.8}%
\contentsline {figure}{\numberline {9}{\ignorespaces Récession virtuelle cumulée en fonction du temps physique. La courbe est mise à jour à partir des états entièrement synchronisés.}}{26}{figure.0.9}%
\contentsline {figure}{\numberline {10}{\ignorespaces Vitesse moyenne de récession sur les 135\,900 noeuds de la surface interne. Les barres représentent \(\pm 1\sigma \) spatial.}}{26}{figure.0.10}%
\contentsline {figure}{\numberline {11}{\ignorespaces Récession virtuelle en fonction de la conversion moyenne. La courbe montre que la récession continue après la quasi-saturation de \(\bar \alpha \).}}{27}{figure.0.11}%
\contentsline {figure}{\numberline {12}{\ignorespaces Vitesse de récession en fonction de la conversion moyenne, avec \(\pm 1\sigma \) spatial.}}{27}{figure.0.12}%
\contentsline {figure}{\numberline {13}{\ignorespaces Profil radial du maximum de \code {SVAR1} au dernier état commun extrait, avec les contours de conversion et la ligne de récession virtuelle. Les rubans hachurés ne contiennent aucun nœud de résultat.}}{28}{figure.0.13}%
\contentsline {figure}{\numberline {14}{\ignorespaces Évolution du maximum radial de \code {SVAR1} dans la simulation 2. La ligne verte discontinue indique, dans chaque panneau, la position cumulée de la récession virtuelle.}}{29}{figure.0.14}%
\contentsline {figure}{\numberline {15}{\ignorespaces Évolution du maximum radial de \code {SVAR2}. Le déplacement du maximum de vitesse de pyrolyse et la progression de la ligne de récession virtuelle sont représentés sur la même coordonnée radiale.}}{30}{figure.0.15}%
\contentsline {figure}{\numberline {16}{\ignorespaces Dépendance axiale de \code {SVAR1} sur la face intérieure chaude de la simulation 2. L'axe axial ne porte pas de ligne de récession, car celle-ci est définie suivant la coordonnée radiale.}}{31}{figure.0.16}%
\contentsline {figure}{\numberline {17}{\ignorespaces Dépendance axiale de \code {SVAR2} sur la face intérieure chaude de la simulation 2. Une échelle verticale propre à chaque panneau rend visibles les faibles valeurs après saturation de la surface.}}{32}{figure.0.17}%
\contentsline {figure}{\numberline {18}{\ignorespaces Écart radial signé entre la ligne de récession virtuelle et les contours de conversion pyrolytique à 99\,\%, 95\,\% et 90\,\%. L'écart est défini par \(\Delta d_\alpha =d_\alpha -s\) : une valeur positive place le contour plus profondément dans la paroi que la récession. La ligne verticale pointillée marque le premier état où la récession virtuelle atteint \SI {1}{\micro m}.}}{34}{figure.0.18}%
