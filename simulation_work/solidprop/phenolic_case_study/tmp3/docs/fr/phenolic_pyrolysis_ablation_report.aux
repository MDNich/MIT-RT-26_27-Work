\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Dépendance axiale de \code {SVAR2} sur la face intérieure chaude de la simulation 2. Une échelle verticale propre à chaque panneau rend visibles les faibles valeurs après saturation de la surface.}}{32}{figure.0.17}\protected@file@percent }
