\babel@toc {ngerman}{}\relax 
\contentsline {figure}{\numberline {1}{\ignorespaces Korrigierte nominale radiale Anordnung. Schichtbreiten sind schematisch; die angegebenen Abmessungen sind radiale Dicken.}}{2}{figure.0.1}%
\contentsline {figure}{\numberline {2}{\ignorespaces Lokale Kopplung in Simulation 1. Die Umwandlung verändert sowohl die Wärmequelle als auch die Eigenschaften im folgenden Teilschritt.}}{11}{figure.0.2}%
\contentsline {figure}{\numberline {3}{\ignorespaces Maximal \code {SVAR1} in einprozentigen Radialbändern von \code {phe0} im letzten konvergierten Zustand. Schraffierte Bänder enthalten keinen Ergebnisknoten und werden durch lineare Interpolation gefüllt.}}{12}{figure.0.3}%
\contentsline {figure}{\numberline {4}{\ignorespaces Entwicklung des radialen Maximums von \code {SVAR1} in \code {phe0} für die gespeicherten Zustände, die 1 bis \SI {6}{s} am nächsten liegen. Die sechs Diagramme sind vertikal angeordnet und verwenden identische Achsen. Gestrichelte Linien und Punkte markieren die Tiefen der Isokonversionsniveaus 0.80, 0.90 und 0.95, sofern diese erreicht werden.}}{14}{figure.0.4}%
\contentsline {figure}{\numberline {5}{\ignorespaces Entwicklung des radialen Maximums von \code {SVAR2} in \code {phe0} für die gespeicherten Zustände, die 1 bis \SI {6}{s} am nächsten liegen. Jedes Feld verwendet dieselbe vertikale Skala; schraffierte Bänder enthalten keinen Ergebnisknoten und werden linear interpoliert.}}{17}{figure.0.5}%
\contentsline {figure}{\numberline {6}{\ignorespaces Axiale Abhängigkeit von \code {SVAR1} auf der heißen Innenfläche von \code {phe0}, gemessen von der unteren Ebene des vernetzten Abschnitts. Alle sechs Felder verwenden dieselbe Skala \(0\leq \alpha \leq 1\).}}{19}{figure.0.6}%
\contentsline {figure}{\numberline {7}{\ignorespaces Axiale Abhängigkeit von \code {SVAR2} auf der heißen Innenfläche von \code {phe0}. Die vertikale Skala ist in jedem Feld unabhängig, sodass die kleinen späten Raten sichtbar bleiben; zu vergleichen sind die Absolutwerte und nicht die relativen Kurvenhöhen der Felder.}}{20}{figure.0.7}%
\contentsline {figure}{\numberline {8}{\ignorespaces Vorgeschlagene physikalische Sequenz für Simulation 2 in Mechanisch. Die Deaktivierung des Elements wird durch Rezession verursacht, nicht direkt durch SVAR1.}}{24}{figure.0.8}%
\contentsline {figure}{\numberline {9}{\ignorespaces Akkumulierte virtuelle Rezession versus physische Zeit. Die Kurve wird aus vollständig synchronisierten Zuständen aktualisiert.}}{28}{figure.0.9}%
\contentsline {figure}{\numberline {10}{\ignorespaces Mittlere Rezessionsrate über die 135\,900 Knoten der Innenfläche. Die Fehlerbalken zeigen die räumliche Streuung \(\pm 1\sigma \).}}{28}{figure.0.10}%
\contentsline {figure}{\numberline {11}{\ignorespaces Virtual recession versus mean conversion. Die Kurve zeigt, dass die Rezession anhält, nachdem \(\bar \alpha \) fast gesättigt ist.}}{29}{figure.0.11}%
\contentsline {figure}{\numberline {12}{\ignorespaces Rezessionsrate versus mittlere Umrechnung, mit räumlichem \(\pm 1\sigma \).}}{29}{figure.0.12}%
\contentsline {figure}{\numberline {13}{\ignorespaces Radiales Maximumprofil von \code {SVAR1} im letzten gemeinsam extrahierten Zustand, einschließlich Umwandlungskonturen und virtueller Rezessionslinie. Schraffierte Bänder enthalten keinen Ergebnisknoten.}}{30}{figure.0.13}%
\contentsline {figure}{\numberline {14}{\ignorespaces Entwicklung des radialen Maximums von \code {SVAR1} in Simulation 2. Die gestrichelte grüne Linie in jedem Feld markiert die kumulative Position der virtuellen Rezession.}}{31}{figure.0.14}%
\contentsline {figure}{\numberline {15}{\ignorespaces Entwicklung des radialen Maximums von \code {SVAR2}. Die Wanderung der maximalen Pyrolyserate und die Fortschreitung der virtuellen Rezessionslinie werden auf derselben radialen Koordinate dargestellt.}}{32}{figure.0.15}%
\contentsline {figure}{\numberline {16}{\ignorespaces Axiale Abhängigkeit von \code {SVAR1} auf der heißen Innenfläche in Simulation 2. Es wird keine Rezessionslinie eingezeichnet, da die Rezession entlang der radialen Koordinate definiert ist.}}{33}{figure.0.16}%
\contentsline {figure}{\numberline {17}{\ignorespaces Axiale Abhängigkeit von \code {SVAR2} auf der heißen Innenfläche in Simulation 2. Eine unabhängige vertikale Skala in jedem Feld macht die kleinen Werte nach der Oberflächensättigung sichtbar.}}{34}{figure.0.17}%
\contentsline {figure}{\numberline {18}{\ignorespaces Signierter radialer Abstand zwischen der virtuellen Rezessionslinie und den Pyrolyse-Umwandlungskonturen bei 99\%, 95\% und 90\%. Der Abstand ist als \(\Delta d_\alpha =d_\alpha -s\) definiert: Ein positiver Wert ordnet die Kontur tiefer in der Wand als die Rezession ein. Die vertikale gestrichelte Linie markiert den ersten Zustand, in dem die virtuelle Rezession \SI {1}{\micro m} erreicht.}}{36}{figure.0.18}%
\contentsline {figure}{\numberline {19}{\ignorespaces In der aktiven Schicht des dünnen Sektors über alle konvergierten Zustände 140 aufgezeichnete mittlere und minimale Umwandlung. Vertikale Linien markieren die beiden radialreihigen Deaktivierungen.}}{38}{figure.0.19}%
\contentsline {figure}{\numberline {20}{\ignorespaces Entwicklung der Ausgasung, des effektiven Konvektionskoeffizienten und der maximalen Temperatur der heißen Oberfläche. Der Gesamtfluss gilt für den Sektor \(0.10^\circ \).}}{39}{figure.0.20}%
\contentsline {figure}{\numberline {21}{\ignorespaces Akkumulierte virtuelle Rezession gegen Zeit für Simulation 3. Die vertikalen Linien markieren den numerischen Beginn der Rezessionsfront und beide radialreihige Deaktivierungen.}}{40}{figure.0.21}%
\contentsline {figure}{\numberline {22}{\ignorespaces Makroschritt-Rezessionsrate. Dies ist eine zeitliche Ableitung der Controller-Historie, ohne einen räumlichen Standardabweichungsbalken.}}{40}{figure.0.22}%
\contentsline {figure}{\numberline {23}{\ignorespaces Akkumulierte virtuelle Rezession versus Mittelwert der aktiven Schicht.}}{41}{figure.0.23}%
\contentsline {figure}{\numberline {24}{\ignorespaces Makroschritt-Rezessionsrate versus Mittelwert-Umrechnung.}}{41}{figure.0.24}%
\contentsline {figure}{\numberline {25}{\ignorespaces Endgültiges radiales \code {SVAR1} Profil bei \SI {7}{s}, einschließlich Umrechnungskonturen und der virtuellen Rezessionslinie.}}{42}{figure.0.25}%
\contentsline {figure}{\numberline {26}{\ignorespaces Entwicklung von radialen \code {SVAR1} Profilen von 1 zu \SI {6}{s}. Die Rezessionslinie wird in jedem Panel angezeigt.}}{43}{figure.0.26}%
\contentsline {figure}{\numberline {27}{\ignorespaces Entwicklung von radialen \code {SVAR2} Profilen; das Maximum identifiziert den Bereich, in dem die Pyrolyse aktiv bleibt.}}{44}{figure.0.27}%
\contentsline {figure}{\numberline {28}{\ignorespaces Axiale Einheitlichkeit von \code {SVAR1} entlang des heißen Gesichts des dünnen Sektors.}}{45}{figure.0.28}%
\contentsline {figure}{\numberline {29}{\ignorespaces Axiale Einheitlichkeit von \code {SVAR2} entlang des heißen Gesichts des dünnen Sektors.}}{46}{figure.0.29}%
\contentsline {figure}{\numberline {30}{\ignorespaces Signierte Trennung zwischen der Rezessionslinie und den 99\%, 95\%, und 90\% Umrechnungskonturen über alle 140 Zustände. Positive Werte legen die Kontur tiefer in die Wand. Die vertikale Linie markiert die erste numerisch signifikante Rezession.}}{47}{figure.0.30}%
