    FilePath=r"C:\ansys_sector_sim2\simulation2_sector_0p10deg_selfcontained.wbpz",
    IncludeUserFiles=True,
    IncludeSkippedFiles=False,
    IncludeExternalImportedFiles=True,
    FailIfMissingFiles=False,
)

